{
  "name": "firestorm-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js",
    "seed:remote": "node scripts/migrate.js --remote && node scripts/seed.js --remote",
    "snapshot": "node scripts/snapshot.js",
    "fit": "node scripts/fit_flame.js",
    "test": "node --test --test-concurrency=1",
    "deploy": "npm test && railway up --service api --ci --path-as-root .",
    "import": "node scripts/import_team.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "onnxruntime-node": "^1.31.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
