# Local dev: Railway public proxy URL (Postgres → Variables → DATABASE_PUBLIC_URL / TCP proxy)
DATABASE_URL=
# Used by `npm run seed:remote`
DATABASE_PUBLIC_URL=
PORT=3000
# Copilot LLM (optional — without it answers come from the template)
LLM_PROVIDER=anthropic   # anthropic | openai (any OpenAI-compatible API)
LLM_API_KEY=
LLM_MODEL=               # default claude-opus-5-5 for anthropic
LLM_BASE_URL=            # openai-compatible only
# Local-only second attempt (do NOT set on Railway)
OLLAMA_URL=
OLLAMA_MODEL=llama3.1
# npm run snapshot
BASE_URL=http://localhost:3000
